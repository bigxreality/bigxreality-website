---
import HomeImage from "@/components/HomeImage.astro";
import type { MediaEntry } from "@/data/homepage-media";

interface Props {
  eyebrow?: string;
  title: string;
  body: string[];
  points: { title: string; body: string }[];
  media: MediaEntry;
}

const { eyebrow, title, body, points, media } = Astro.props;
---

<section class="bg-white py-15 md:py-[80px] xl:py-30">
  <div class="mx-auto max-w-[1440px] px-5 md:px-12 xl:px-20 grid grid-cols-1 lg:grid-cols-2 gap-10 xl:gap-16 items-center">
    <div class="reveal">
      {
        eyebrow && (
          <p class="text-label font-mono font-bold uppercase tracking-[0.1em] text-ink-muted mb-2">
            {eyebrow}
          </p>
        )
      }
      <h2 class="text-h2-sm md:text-h2-md xl:text-h2 font-bold leading-[1.25] text-ink">{title}</h2>
      {
        body.map((paragraph) => (
          <p class="mt-6 text-base leading-[1.75] text-ink-body max-w-xl">{paragraph}</p>
        ))
      }

      <dl class="mt-10 grid grid-cols-1 sm:grid-cols-2 gap-6 max-w-xl">
        {
          points.map((point) => (
            <div class="border-t border-border-light pt-4">
              <dt class="text-h3 font-semibold text-ink">{point.title}</dt>
              <dd class="mt-2 text-body-sm leading-[1.6] text-ink-muted">{point.body}</dd>
            </div>
          ))
        }
      </dl>
    </div>

    <div class="reveal rounded overflow-hidden aspect-[4/3]">
      <HomeImage media={media} width={1200} height={900} />
    </div>
  </div>
</section>
