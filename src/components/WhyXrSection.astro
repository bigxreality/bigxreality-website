---
import HomeImage from "@/components/HomeImage.astro";
import type { MediaEntry } from "@/data/homepage-media";

interface Point {
  index: string;
  title: string;
  body: string;
}

interface Props {
  eyebrow: string;
  title: string;
  subtitle: string;
  points: Point[];
  media: MediaEntry;
}

const { eyebrow, title, subtitle, points, media } = Astro.props;
---

<section class="bg-navy-800 py-15 md:py-[80px] xl:py-30">
  <div class="mx-auto max-w-[1440px] px-5 md:px-12 xl:px-20">
    <div class="reveal max-w-2xl">
      <p class="text-label font-mono font-bold uppercase tracking-[0.1em] text-text-muted mb-2">{eyebrow}</p>
      <h2 class="text-h2-sm md:text-h2-md xl:text-h2 font-bold leading-[1.25] text-white">
        {title}
      </h2>
      <p class="mt-6 text-base leading-[1.75] text-text-body">{subtitle}</p>
    </div>

    <div class="reveal mt-10 rounded overflow-hidden aspect-[16/9] border border-border">
      <HomeImage media={media} width={1920} height={1080} />
    </div>

    <div class="mt-12 md:mt-16 grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-8 md:gap-y-10">
      {
        points.map((point) => (
          <div class="reveal border-t md:border-t-0 md:border-l border-border pt-6 md:pt-0 md:pl-8">
            <span class="text-2xl font-extrabold text-brand">{point.index}</span>
            <h3 class="mt-3 text-h3 font-semibold text-white">{point.title}</h3>
            <p class="mt-2 text-body-sm leading-[1.6] text-text-muted">{point.body}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
