---
import HomeImage from "@/components/HomeImage.astro";
import { withBase } from "@/i18n/utils";
import type { MediaEntry } from "@/data/homepage-media";

interface Props {
  href: string;
  date: string;
  category: string;
  title: string;
  excerpt?: string;
  media?: MediaEntry;
  readMoreLabel: string;
  featured?: boolean;
}

const { href, date, category, title, excerpt, media, readMoreLabel, featured = false } = Astro.props;
---

<a
  href={withBase(href)}
  class="group block rounded overflow-hidden border border-border bg-bg-soft transition-colors hover:border-brand focus-visible:outline focus-visible:outline-2 focus-visible:outline-brand h-full flex flex-col"
>
  {
    media && (
      <div class:list={["relative", featured ? "aspect-[16/9]" : "aspect-[16/9]"]}>
        <HomeImage media={media} width={800} height={450} />
      </div>
    )
  }
  <div class="p-5 flex flex-col flex-1 min-w-0">
    <div>
      <span class="text-caption text-text-faint">{date}</span>
      <span class="ml-3 text-[11px] font-mono uppercase tracking-[0.06em] text-brand">{category}</span>
    </div>
    <h3
      class:list={[
        "mt-2 font-bold leading-[1.3] text-white group-hover:text-brand transition-colors",
        featured ? "text-h2-sm md:text-h2-md" : "text-h3",
      ]}
    >
      {title}
    </h3>
    {excerpt && <p class="mt-2 text-body-sm leading-[1.6] text-text-muted flex-1">{excerpt}</p>}
    <span class="mt-3 text-[15px] font-semibold text-brand">{readMoreLabel} →</span>
  </div>
</a>
