---
import { withBase } from "@/i18n/utils";

interface Props {
  href: string;
  date: string;
  category: string;
  title: string;
  featured?: boolean;
}

const { href, date, category, title, featured = false } = Astro.props;
---

{
  featured ? (
    <a
      href={withBase(href)}
      class="group block border-t-2 border-brand pt-5 focus-visible:outline focus-visible:outline-2 focus-visible:outline-brand rounded"
    >
      <span class="text-caption text-text-faint">{date}</span>
      <span class="ml-3 text-[11px] uppercase tracking-[0.06em] text-brand">{category}</span>
      <h3 class="mt-3 text-h2-sm md:text-h2-md font-bold leading-[1.3] text-white group-hover:text-brand transition-colors">
        {title}
      </h3>
    </a>
  ) : (
    <a
      href={withBase(href)}
      class="group block py-4 first:pt-0 border-b border-border last:border-b-0 focus-visible:outline focus-visible:outline-2 focus-visible:outline-brand rounded"
    >
      <span class="text-caption text-text-faint">{date}</span>
      <span class="ml-3 text-[11px] uppercase tracking-[0.06em] text-text-muted">{category}</span>
      <h4 class="mt-1 text-h3 font-medium leading-[1.4] text-text-body2 group-hover:text-brand transition-colors">
        {title}
      </h4>
    </a>
  )
}
