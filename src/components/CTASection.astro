---
import Button from "@/components/Button.astro";
import HomeImage from "@/components/HomeImage.astro";
import { withBase } from "@/i18n/utils";
import type { MediaEntry } from "@/data/homepage-media";

interface LinkItem {
  label: string;
  href: string;
}

interface Props {
  eyebrow: string;
  title: string;
  ctaPrimary: LinkItem;
  ctaSecondary?: LinkItem;
  media: MediaEntry;
}

const { eyebrow, title, ctaPrimary, ctaSecondary, media } = Astro.props;
---

<section class="relative overflow-hidden bg-navy-600 py-15 md:py-[80px] xl:py-30">
  <div class="absolute inset-0">
    <HomeImage media={media} width={1920} height={900} class="opacity-30" />
    <div class="absolute inset-0 bg-gradient-to-br from-navy-600/90 to-bg/95"></div>
  </div>
  <div
    class="absolute inset-0 opacity-[0.12]"
    style="background-image: linear-gradient(rgba(255,255,255,0.5) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.5) 1px, transparent 1px); background-size: 56px 56px;"
    aria-hidden="true"
  >
  </div>
  <div class="relative mx-auto max-w-[1440px] px-5 md:px-12 xl:px-20 text-center">
    <div class="reveal">
      <p class="text-label font-bold uppercase tracking-[0.1em] text-brand mb-4">{eyebrow}</p>
      <h2 class="text-h2-sm md:text-h2-md xl:text-h2 font-bold leading-[1.25] text-white max-w-3xl mx-auto">
        {title}
      </h2>
      <div class="mt-8 flex flex-col sm:flex-row justify-center gap-4">
        <Button href={withBase(ctaPrimary.href)} variant="primary">{ctaPrimary.label}</Button>
        {ctaSecondary && (
          <Button href={withBase(ctaSecondary.href)} variant="secondary">{ctaSecondary.label}</Button>
        )}
      </div>
    </div>
  </div>
</section>
