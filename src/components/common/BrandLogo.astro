---
// Single shared brand mark, used identically by Header, Footer, and the
// mobile menu (folded into Header). Never duplicate/hardcode the logo
// markup elsewhere — swap the files in public/images/brand/ instead.
//
// variant "light" = light/white-text mark, for dark backgrounds (Header,
// Hero, dark Footer/CTA). variant "dark" = dark/black-text mark, for light
// backgrounds (white sections, print).
import fs from "node:fs";
import path from "node:path";
import { withBase, type Locale } from "@/i18n/utils";

interface Props {
  locale: Locale;
  variant: "light" | "dark";
  class?: string;
}

const { locale, variant, class: className = "h-6 md:h-7 lg:h-8 w-auto" } = Astro.props;

// SVG takes priority over PNG so a future SVG upload needs no code change:
// just add the .svg file under public/images/brand/ with this exact name
// and remove the .png (or keep both — SVG will always be picked first).
const candidates = [`big-x-reality-logo-${variant}.svg`, `big-x-reality-logo-${variant}.png`];
const publicDir = path.resolve(process.cwd(), "public/images/brand");
const found = candidates.find((name) => fs.existsSync(path.join(publicDir, name)));
const logoSrc = found ? `/images/brand/${found}` : null;
---

<a
  href={withBase(`/${locale}/`)}
  class="inline-flex items-center focus-visible:outline focus-visible:outline-2 focus-visible:outline-brand rounded"
>
  {
    logoSrc ? (
      <img src={withBase(logoSrc)} alt="Big x Reality" class={className} />
    ) : (
      // TODO: temporary text fallback until the real logo file is uploaded
      // to public/images/brand/big-x-reality-logo-{light,dark}.{svg,png} —
      // this is NOT the final brand asset.
      <span class="text-lg md:text-xl font-extrabold text-white tracking-tight">
        BIG<span class="text-brand">x</span>REALITY
      </span>
    )
  }
</a>
