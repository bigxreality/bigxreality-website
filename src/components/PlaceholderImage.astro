---
interface Props {
  alt: string;
  id: string;
  ratio?: string;
  class?: string;
}
const { alt, id, ratio = "4 / 3", class: className = "" } = Astro.props;
---

<div
  class={`placeholder-texture relative w-full overflow-hidden ${className}`}
  style={`aspect-ratio: ${ratio}`}
  role="img"
  aria-label={alt}
>
  <div class="absolute inset-0 flex flex-col items-start justify-end p-4 gap-1">
    <span class="text-[10px] uppercase tracking-[0.08em] text-text-faint">
      IMAGE PLACEHOLDER · {id}
    </span>
    <span class="text-body-sm text-text-muted max-w-[85%]">{alt}</span>
  </div>
</div>
