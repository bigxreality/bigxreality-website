---
import SolutionCard from "@/components/SolutionCard.astro";
import { withBase } from "@/i18n/utils";

interface SolutionItem {
  href: string;
  code: string;
  title: string;
  excerpt: string;
  image: { src: string; alt: string };
}

interface Props {
  title: string;
  allLinkLabel: string;
  allLinkHref: string;
  learnMoreLabel: string;
  items: SolutionItem[];
}

const { title, allLinkLabel, allLinkHref, learnMoreLabel, items } = Astro.props;
const [featured, ...rest] = items;
---

<section class="bg-bg py-15 md:py-[80px] xl:py-30">
  <div class="mx-auto max-w-[1440px] px-5 md:px-12 xl:px-20">
    <div class="reveal flex flex-col md:flex-row md:items-end md:justify-between gap-4">
      <h2 class="text-h2-sm md:text-h2-md xl:text-h2 font-bold leading-[1.25] text-white">{title}</h2>
      <a
        href={withBase(allLinkHref)}
        class="text-brand hover:text-brand-hover text-[15px] font-semibold w-fit focus-visible:outline focus-visible:outline-2 focus-visible:outline-brand rounded"
      >
        {allLinkLabel} →
      </a>
    </div>

    {
      featured && (
        <div class="reveal mt-10 md:mt-12">
          <SolutionCard {...featured} learnMoreLabel={learnMoreLabel} featured />
        </div>
      )
    }

    <div class="mt-6 grid grid-cols-1 md:grid-cols-3 gap-6">
      {rest.map((item) => (
        <div class="reveal">
          <SolutionCard {...item} learnMoreLabel={learnMoreLabel} />
        </div>
      ))}
    </div>
  </div>
</section>
