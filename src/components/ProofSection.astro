---
import HomeImage from "@/components/HomeImage.astro";
import type { MediaEntry } from "@/data/homepage-media";

interface Item {
  title: string;
  body: string;
}

interface Props {
  eyebrow: string;
  title: string;
  intro: string;
  items: Item[];
  media: MediaEntry;
  partnersLabel: string;
  partners: string[];
}

const { eyebrow, title, intro, items, media, partnersLabel, partners } = Astro.props;
---

<section class="bg-white py-15 md:py-[80px] xl:py-30">
  <div class="mx-auto max-w-[1440px] px-5 md:px-12 xl:px-20">
    <div class="reveal max-w-2xl">
      <p class="text-label font-mono font-bold uppercase tracking-[0.1em] text-brand mb-2">{eyebrow}</p>
      <h2 class="text-h2-sm md:text-h2-md xl:text-h2 font-bold leading-[1.25] text-ink">{title}</h2>
      <p class="mt-6 text-base leading-[1.75] text-ink-body">{intro}</p>
    </div>

    <div class="reveal mt-10 rounded overflow-hidden aspect-[16/9] border border-border-light">
      <HomeImage media={media} width={1920} height={1080} />
    </div>

    <div class="mt-10 md:mt-14 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {
        items.map((item) => (
          <div class="border-t border-border-light pt-4">
            <h3 class="text-h3 font-semibold text-ink">{item.title}</h3>
            <p class="mt-2 text-body-sm leading-[1.6] text-ink-muted">{item.body}</p>
          </div>
        ))
      }
    </div>

    {
      partners.length > 0 && (
        <div class="mt-12 md:mt-16 border-t border-border-light pt-8">
          <p class="text-label font-mono font-bold uppercase tracking-[0.1em] text-ink-muted mb-5">
            {partnersLabel}
          </p>
          <ul class="flex flex-wrap gap-x-10 gap-y-3">
            {partners.map((name) => (
              <li class="text-body-sm text-ink-muted whitespace-nowrap">{name}</li>
            ))}
          </ul>
        </div>
      )
    }
  </div>
</section>
