---
import { withBase } from "@/i18n/utils";
import type { MediaEntry } from "@/data/homepage-media";

interface Props {
  code: string;
  englishLabel: string;
  navTitle: string;
  excerpt: string;
  representativeApplication?: string;
  href: string;
  exploreLabel: string;
  media: MediaEntry;
  reverse?: boolean;
}

const {
  code,
  englishLabel,
  navTitle,
  excerpt,
  representativeApplication,
  href,
  exploreLabel,
  media,
  reverse = false,
} = Astro.props;
---

<div
  class:list={[
    "reveal grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-16 items-center py-10 md:py-14 border-t border-border first:border-t-0 first:pt-0",
  ]}
>
  <div class:list={["relative aspect-[16/9] rounded overflow-hidden", reverse ? "lg:order-2" : ""]}>
    <img
      src={withBase(media.src)}
      alt={media.alt}
      width={1600}
      height={900}
      loading="lazy"
      decoding="async"
      class="w-full h-full object-cover"
    />
    <div
      class="absolute inset-0 opacity-[0.15]"
      style="background-image: linear-gradient(rgba(255,255,255,0.4) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.4) 1px, transparent 1px); background-size: 40px 40px;"
      aria-hidden="true"
    >
    </div>
  </div>

  <div class:list={[reverse ? "lg:order-1" : ""]}>
    <span class="text-label font-mono font-bold uppercase tracking-[0.1em] text-brand">
      {code ? `${code} ` : ""}{englishLabel}
    </span>
    <h3 class="mt-3 text-h2-sm md:text-h2-md font-bold leading-[1.25] text-white">{navTitle}</h3>
    <p class="mt-4 text-base leading-[1.75] text-text-body max-w-xl">{excerpt}</p>
    {
      representativeApplication && (
        <p class="mt-3 text-body-sm text-text-muted">代表性應用：{representativeApplication}</p>
      )
    }
    <a
      href={withBase(href)}
      class="mt-6 inline-flex items-center gap-2 text-brand hover:text-brand-hover text-[15px] font-semibold focus-visible:outline focus-visible:outline-2 focus-visible:outline-brand rounded"
    >
      {exploreLabel} →
    </a>
  </div>
</div>
