---
interface Props {
  eyebrow: string;
  title: string;
  items: string[];
  class?: string;
}

const { eyebrow, title, items, class: className = "" } = Astro.props;
---

<div class={className}>
  <p class="text-label font-bold uppercase tracking-[0.1em] text-text-muted mb-2">{eyebrow}</p>
  <h2 class="text-h2-sm md:text-h2-md xl:text-h2 font-bold leading-[1.25] text-white">{title}</h2>

  <ul class="mt-8 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
    {
      items.map((item) => (
        <li class="bg-bg-soft border border-border rounded px-4 py-3 text-body-sm text-text-body2 leading-[1.5]">
          {item}
        </li>
      ))
    }
  </ul>
</div>
