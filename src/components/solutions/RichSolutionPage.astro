---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import SEOHead from "@/components/SEOHead.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import DetailHero from "@/components/solutions/DetailHero.astro";
import RichSections from "@/components/solutions/RichSections.astro";
import CTASection from "@/components/CTASection.astro";
import { withBase, type Locale } from "@/i18n/utils";
import { homepageMedia } from "@/data/homepage-media";
import { solutionsMedia } from "@/data/solutions-media";
import { solutionsRich, type RichSolutionSlug } from "@/data/solutions-rich";

interface Props {
  locale: "en" | "ja";
  slug: RichSolutionSlug;
}

const { locale, slug } = Astro.props;

const settingsEntries = await getCollection("siteSettings");
const settings = settingsEntries.find((e) => e.data.locale === (locale as Locale))!.data;
const data = solutionsRich[locale][slug];

const mediaBySlug = {
  military: solutionsMedia.military,
  police: solutionsMedia.police,
  "smart-city": solutionsMedia.smartCity,
} as const;
const media = mediaBySlug[slug];
// First sentence of the official "About" paragraph, used as the hero
// subtitle so we don't invent new tagline copy.
const heroSubtitle = data.aboutBody.split(/(?<=[.。])\s/)[0];

const breadcrumbLabels = {
  en: { home: "Home", solutions: "Solutions" },
  ja: { home: "ホーム", solutions: "ソリューション" },
};
const bc = breadcrumbLabels[locale];
---

<Layout locale={locale}>
  <Fragment slot="head">
    <SEOHead
      locale={locale}
      path={`/solutions/${slug}/`}
      title={data.seoTitle}
      description={data.seoDescription}
    />
  </Fragment>

  <Header
    locale={locale}
    currentPath={`/${locale}/solutions/${slug}/`}
    nav={settings.nav.primary}
    cta={settings.nav.cta}
  />

  <main class="flex-1">
    <DetailHero
      englishLabel={data.englishLabel}
      title={data.navTitle}
      subtitle={heroSubtitle}
      heroDesktop={media.heroDesktop}
      heroMobile={media.heroMobile}
    />

    <div class="bg-navy-800">
      <div class="mx-auto max-w-[1440px] px-5 md:px-12 xl:px-20 py-4">
        <Breadcrumb
          items={[
            { label: bc.home, href: withBase(`/${locale}/`) },
            { label: bc.solutions, href: withBase(`/${locale}/solutions/`) },
            { label: data.navTitle },
          ]}
        />
      </div>
    </div>

    <RichSections
      aboutHeading={data.aboutHeading}
      aboutBody={data.aboutBody}
      sections={data.sections}
      specialtiesHeading={data.specialtiesHeading}
      specialties={data.specialties}
    />

    <CTASection
      eyebrow={settings.missionCta.eyebrow}
      title={settings.missionCta.title}
      ctaPrimary={settings.missionCta.ctaPrimary}
      ctaSecondary={settings.missionCta.ctaSecondary}
      media={homepageMedia.cta.contact}
    />
  </main>

  <Footer
    companyName={settings.footer.companyName}
    address={settings.footer.address}
    email={settings.footer.email}
    menu={settings.footer.menu}
    about={settings.footer.about}
    newsletterLabel={settings.footer.newsletterLabel}
    newsletterPlaceholder={settings.footer.newsletterPlaceholder}
    subscribeLabel={settings.footer.subscribeLabel}
    copyright={settings.footer.copyright}
  />
</Layout>
