---
import Card from "@/components/Card.astro";
import PlaceholderImage from "@/components/PlaceholderImage.astro";

interface Props {
  code: string;
  category: string;
  title: string;
  excerpt: string;
  image: { src: string; alt: string };
}

const { code, category, title, excerpt, image } = Astro.props;
---

<Card class="h-full flex flex-col">
  <div class="relative">
    <PlaceholderImage
      id={image.src.split("/").pop() ?? "case"}
      alt={image.alt}
      ratio="4 / 3"
      class="h-[160px] md:h-[180px]"
    />
    <span class="absolute top-3 left-3 text-[10px] uppercase tracking-[0.08em] text-white bg-bg/60 border border-white/[0.15] rounded px-2 py-1">
      {code}
    </span>
  </div>
  <div class="p-5 flex flex-col flex-1">
    <span class="text-[11px] uppercase tracking-[0.06em] text-brand">{category}</span>
    <h3 class="mt-2 text-h3 font-semibold text-white">{title}</h3>
    <p class="mt-2 text-body-sm leading-[1.6] text-text-muted flex-1">{excerpt}</p>
  </div>
</Card>
