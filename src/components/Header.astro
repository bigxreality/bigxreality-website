---
import LanguageSwitcher from "@/components/LanguageSwitcher.astro";
import { locales, withBase, type Locale } from "@/i18n/utils";

interface NavItem {
  label: string;
  href: string;
}

interface Props {
  locale: Locale;
  currentPath: string;
  nav: NavItem[];
  cta: NavItem;
  availableLocales?: readonly Locale[];
}

const { locale, currentPath, nav, cta, availableLocales = locales } = Astro.props;
---

<header
  id="site-header"
  data-header
  class="fixed inset-x-0 top-0 z-50 transition-colors duration-300 bg-transparent border-b border-transparent"
>
  <div class="mx-auto flex max-w-[1440px] items-center justify-between px-5 md:px-12 xl:px-20 h-16 md:h-20">
    <a
      href={withBase(`/${locale}/`)}
      class="text-lg md:text-xl font-extrabold text-white tracking-tight focus-visible:outline focus-visible:outline-2 focus-visible:outline-brand"
    >
      BIG<span class="text-brand">x</span>REALITY
    </a>

    <nav class="hidden lg:flex items-center gap-5 xl:gap-7">
      {
        nav.map((item) => (
          <a
            href={withBase(item.href)}
            class="text-body-sm md:text-[15px] text-text-body2 hover:text-brand transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-brand rounded"
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="hidden lg:flex items-center gap-4">
      <LanguageSwitcher locale={locale} currentPath={currentPath} availableLocales={availableLocales} />
      <a
        href={withBase(cta.href)}
        class="bg-brand hover:bg-brand-hover text-white rounded px-5 py-2.5 text-[15px] font-semibold transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
      >
        {cta.label}
      </a>
    </div>

    <button
      type="button"
      data-menu-toggle
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="開啟選單"
      class="lg:hidden flex flex-col justify-center gap-1.5 w-10 h-10 focus-visible:outline focus-visible:outline-2 focus-visible:outline-brand rounded"
    >
      <span class="menu-bar block h-0.5 w-6 bg-white transition-transform"></span>
      <span class="menu-bar block h-0.5 w-6 bg-white transition-opacity"></span>
      <span class="menu-bar block h-0.5 w-6 bg-white transition-transform"></span>
    </button>
  </div>

  <div
    id="mobile-menu"
    data-menu-panel
    class="lg:hidden overflow-y-auto bg-bg-soft border-t border-border max-h-0 transition-[max-height] duration-300"
  >
    <nav class="flex flex-col px-5 py-4 gap-1">
      {
        nav.map((item) => (
          <a
            href={withBase(item.href)}
            class="py-3 text-body text-text-body2 border-b border-border last:border-b-0 hover:text-brand transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-brand rounded"
          >
            {item.label}
          </a>
        ))
      }
    </nav>
    <div class="px-5 pb-6 flex flex-col gap-4">
      <LanguageSwitcher locale={locale} currentPath={currentPath} availableLocales={availableLocales} />
      <a
        href={withBase(cta.href)}
        class="bg-brand hover:bg-brand-hover text-white rounded px-5 py-3 text-[15px] font-semibold text-center transition-colors"
      >
        {cta.label}
      </a>
    </div>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>("[data-header]");
  const toggle = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
  const panel = document.querySelector<HTMLElement>("[data-menu-panel]");

  function setScrolled() {
    if (!header) return;
    const scrolled = window.scrollY > 8;
    header.classList.toggle("bg-bg-soft/95", scrolled);
    header.classList.toggle("backdrop-blur", scrolled);
    header.classList.toggle("border-border", scrolled);
    header.classList.toggle("bg-transparent", !scrolled);
    header.classList.toggle("border-transparent", !scrolled);
  }
  setScrolled();
  window.addEventListener("scroll", setScrolled, { passive: true });

  let open = false;
  function setOpen(next: boolean) {
    open = next;
    toggle?.setAttribute("aria-expanded", String(open));
    toggle?.setAttribute("aria-label", open ? "關閉選單" : "開啟選單");
    panel?.classList.toggle("max-h-[calc(100vh-4rem)]", open);
    panel?.classList.toggle("max-h-0", !open);
    document.body.style.overflow = open ? "hidden" : "";
    header?.querySelectorAll(".menu-bar").forEach((bar, i) => {
      bar.classList.toggle("translate-y-2", open && i === 0);
      bar.classList.toggle("rotate-45", open && i === 0);
      bar.classList.toggle("opacity-0", open && i === 1);
      bar.classList.toggle("-translate-y-2", open && i === 2);
      bar.classList.toggle("-rotate-45", open && i === 2);
    });
  }
  toggle?.addEventListener("click", () => setOpen(!open));
  window.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && open) setOpen(false);
  });
</script>
