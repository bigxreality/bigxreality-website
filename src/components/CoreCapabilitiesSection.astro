---
import HomeImage from "@/components/HomeImage.astro";
import type { MediaEntry } from "@/data/homepage-media";

interface Item {
  title: string;
  body: string;
}

interface Props {
  eyebrow: string;
  title: string;
  intro: string;
  items: Item[];
  media: MediaEntry;
}

const { eyebrow, title, intro, items, media } = Astro.props;
---

<section class="bg-bg py-15 md:py-[80px] xl:py-30">
  <div class="mx-auto max-w-[1440px] px-5 md:px-12 xl:px-20">
    <div class="reveal max-w-2xl">
      <p class="text-label font-mono font-bold uppercase tracking-[0.1em] text-text-muted mb-2">{eyebrow}</p>
      <h2 class="text-h2-sm md:text-h2-md xl:text-h2 font-bold leading-[1.25] text-white">{title}</h2>
      <p class="mt-6 text-base leading-[1.75] text-text-body">{intro}</p>
    </div>

    <div class="mt-10 md:mt-14 grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16 items-start">
      <div class="reveal rounded overflow-hidden aspect-[3/2] order-2 lg:order-1">
        <HomeImage media={media} width={1600} height={1067} />
      </div>

      <div class="reveal grid grid-cols-1 sm:grid-cols-2 gap-6 order-1 lg:order-2">
        {
          items.map((item) => (
            <div class="border-t border-border pt-4">
              <h3 class="text-h3 font-semibold text-white">{item.title}</h3>
              <p class="mt-2 text-body-sm leading-[1.6] text-text-muted">{item.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
