---
import { withBase } from "@/i18n/utils";

interface VideoSlide {
  src: string;
  poster?: string;
}

interface Props {
  slides: VideoSlide[];
  // Shown instead of video for prefers-reduced-motion users and as the
  // <video poster>/fallback image.
  posterAlt: string;
}

const { slides, posterAlt } = Astro.props;
---

<div class="absolute inset-0 -z-10" data-hero-video-slider>
  {
    slides.map((slide, i) => (
      <div
        class="hero-video-slide absolute inset-0 transition-opacity duration-1000"
        style={`opacity: ${i === 0 ? 1 : 0}`}
        data-slide-index={i}
      >
        <video
          src={withBase(slide.src)}
          poster={slide.poster ? withBase(slide.poster) : undefined}
          aria-label={posterAlt}
          autoplay
          muted
          loop={slides.length === 1}
          playsinline
          preload={i === 0 ? "auto" : "none"}
          class="w-full h-full object-cover opacity-70"
        />
      </div>
    ))
  }
  <div class="absolute inset-0 bg-gradient-to-t from-bg via-navy-800/60 to-navy-800/20"></div>
  <div
    class="absolute inset-0 opacity-[0.15]"
    style="background-image: linear-gradient(rgba(255,255,255,0.4) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.4) 1px, transparent 1px); background-size: 48px 48px;"
    aria-hidden="true"
  >
  </div>

  {
    slides.length > 1 && (
      <div class="absolute bottom-6 left-1/2 -translate-x-1/2 flex gap-2 z-10">
        {slides.map((_, i) => (
          <button
            type="button"
            class="slide-dot w-2 h-2 rounded-full bg-white/40 data-[active=true]:bg-brand transition-colors"
            data-slide-dot={i}
            aria-label={`第 ${i + 1} 支影片`}
          />
        ))}
      </div>
    )
  }
</div>

<script>
  const root = document.querySelector<HTMLElement>("[data-hero-video-slider]");
  if (root) {
    const slideEls = Array.from(root.querySelectorAll<HTMLElement>(".hero-video-slide"));
    const videos = slideEls.map((s) => s.querySelector("video")!);
    const dots = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-slide-dot]"));
    const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    let active = 0;
    function show(index: number) {
      active = index;
      slideEls.forEach((s, i) => {
        s.style.opacity = i === index ? "1" : "0";
      });
      dots.forEach((d, i) => (d.dataset.active = String(i === index)));
      if (!prefersReducedMotion) {
        videos[index]?.play().catch(() => {});
      }
    }
    dots.forEach((dot, i) => dot.addEventListener("click", () => show(i)));

    if (prefersReducedMotion) {
      // Respect reduced-motion: pause all videos, show first frame only,
      // no auto-advancing carousel.
      videos.forEach((v) => v.pause());
    } else if (videos.length > 1) {
      videos[active]?.addEventListener("ended", () => show((active + 1) % videos.length));
    }
  }
</script>
