---
import HomeImage from "@/components/HomeImage.astro";
import type { MediaEntry } from "@/data/homepage-media";

interface Card {
  title: string;
  body: string;
}

interface Props {
  eyebrow: string;
  title: string;
  intro: string;
  cards: Card[];
  media: MediaEntry;
}

const { eyebrow, title, intro, cards, media } = Astro.props;
---

<section class="relative overflow-hidden bg-navy-800 py-15 md:py-[80px] xl:py-30">
  <div class="absolute inset-0">
    <HomeImage media={media} width={1920} height={1080} class="opacity-20" />
    <div class="absolute inset-0 bg-navy-800/85"></div>
  </div>

  <div class="relative mx-auto max-w-[1440px] px-5 md:px-12 xl:px-20">
    <div class="reveal max-w-2xl">
      <p class="text-label font-mono font-bold uppercase tracking-[0.1em] text-brand mb-4">{eyebrow}</p>
      <h2 class="text-h2-sm md:text-h2-md xl:text-h2 font-bold leading-[1.25] text-white">{title}</h2>
      <p class="mt-6 text-base leading-[1.75] text-text-body">{intro}</p>
    </div>

    <div class="reveal mt-10 md:mt-14 grid grid-cols-1 sm:grid-cols-2 gap-6">
      {
        cards.map((card) => (
          <div class="bg-bg-soft/80 backdrop-blur-sm border border-border rounded p-6">
            <h3 class="text-h3 font-semibold text-white">{card.title}</h3>
            <p class="mt-3 text-body-sm leading-[1.6] text-text-muted">{card.body}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
