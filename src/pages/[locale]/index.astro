---
import { getCollection, type CollectionEntry } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import SEOHead from "@/components/SEOHead.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import HeroVideoSlider from "@/components/HeroVideoSlider.astro";
import Button from "@/components/Button.astro";
import AboutSection from "@/components/AboutSection.astro";
import TrainingChallengesSection from "@/components/TrainingChallengesSection.astro";
import WhyXrSection from "@/components/WhyXrSection.astro";
import SolutionsSection from "@/components/SolutionsSection.astro";
import CoreCapabilitiesSection from "@/components/CoreCapabilitiesSection.astro";
import ProofSection from "@/components/ProofSection.astro";
import ContentCardGrid from "@/components/ContentCardGrid.astro";
import CTASection from "@/components/CTASection.astro";
import { locales, withBase, type Locale } from "@/i18n/utils";
import { homepageMedia } from "@/data/homepage-media";

export async function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };

const settingsEntries = await getCollection("siteSettings");
const settings = settingsEntries.find((e) => e.data.locale === locale)!.data;

function byLocale<T extends { data: { locale: string } }>(entries: T[]) {
  return entries.filter((e) => e.data.locale === locale);
}

const solutionEntries = byLocale(await getCollection("solutions")).sort(
  (a, b) => a.data.order - b.data.order
) as CollectionEntry<"solutions">[];

const newsEntries = byLocale(await getCollection("news")).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
) as CollectionEntry<"news">[];

const caseEntries = byLocale(await getCollection("caseStudies")).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
) as CollectionEntry<"caseStudies">[];

// Solution slug (matches /zh-tw/solutions/<slug>/) -> centralized media key
// (see src/data/homepage-media.ts)
const solutionMediaKey: Record<string, keyof typeof homepageMedia.solutions> = {
  police: "police",
  military: "military",
  "smart-city": "smartCity",
  "fire-rescue": "fire",
};

const seoTitleByLocale: Record<Locale, string> = {
  "zh-tw": "AI XR 模擬訓練解決方案｜軍事、警勤、消防與智慧城市｜Big x Reality",
  en: "Big x Reality | Global Power Technology XR Training Solutions",
  jp: "Big x Reality｜全球動力科技 XRトレーニングソリューション",
};

const seoDescriptionByLocale: Record<Locale, string> = {
  "zh-tw":
    "Big x Reality 整合 AI、XR、VR、多人空間定位與模擬設備，提供軍事、警勤、消防、智慧城市、小部隊戰術、武器、無人機及載具模擬訓練解決方案。",
  en: "Global Power Technology's Big x Reality delivers XR training simulation solutions for law enforcement, defense, fire & rescue, and smart city agencies.",
  jp: "全球動力科技のBig x Realityは、警察・消防・スマートシティ向けのXRトレーニングシミュレーションソリューションを提供します。",
};

// zh-tw only this round — en/jp cases+news card content (casesSection/
// newsSection copy) doesn't exist yet.
const showContentCards = locale === "zh-tw";

const siteUrl = Astro.site?.origin ?? "https://bigxreality.github.io";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const homeUrl = new URL(`${base}/${locale}/`, siteUrl).toString();

// Organization/WebSite describe the real, already-published company info
// (see settings.footer); ItemList mirrors the four solution cards actually
// rendered below. No BreadcrumbList here — the homepage is the root, a
// single-item breadcrumb wouldn't be meaningful.
const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    name: settings.footer.companyName,
    url: homeUrl,
    email: settings.footer.email,
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "Big x Reality",
    url: homeUrl,
    inLanguage: locale === "jp" ? "ja" : locale === "en" ? "en" : "zh-TW",
  },
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    itemListElement: solutionEntries.map((e, i) => ({
      "@type": "ListItem",
      position: i + 1,
      name: e.data.title,
      url: new URL(`${base}/${locale}/solutions/${e.data.itemSlug}/`, siteUrl).toString(),
    })),
  },
];
---

<Layout locale={locale}>
  <Fragment slot="head">
    <SEOHead
      locale={locale}
      path="/"
      title={seoTitleByLocale[locale]}
      description={seoDescriptionByLocale[locale]}
      structuredData={structuredData}
    />
  </Fragment>

  <Header locale={locale} currentPath={`/${locale}/`} nav={settings.nav.primary} cta={settings.nav.cta} />

  <main class="flex-1">
    <section class="relative isolate overflow-hidden bg-navy-800 pt-16 md:pt-20">
      <HeroVideoSlider
        slides={[
          { src: "/images/home/hero/home-hero-video-1.mp4", objectPosition: "center 30%" },
          { src: "/images/home/hero/home-hero-video-2.mp4", objectPosition: "center 38%" },
        ]}
        posterAlt={homepageMedia.hero.desktop.alt}
      />
      <div class="mx-auto max-w-[1440px] px-5 md:px-12 xl:px-20 pt-16 pb-24 md:pt-24 md:pb-32 xl:pt-32 xl:pb-40">
        <p class="text-label font-mono font-bold uppercase tracking-[0.1em] text-brand mb-6">
          {settings.hero.eyebrow}
        </p>
        <h1 class="text-h1-sm md:text-h1-md xl:text-h1 font-extrabold leading-[1.12] text-white max-w-4xl">
          {settings.hero.title}
        </h1>
        {
          settings.hero.tagline && (
            <p class="mt-4 text-label md:text-lg font-mono font-bold uppercase tracking-[0.08em] text-text-body2">
              {settings.hero.tagline}
            </p>
          )
        }
        <p class="mt-6 text-base md:text-lg leading-[1.75] text-text-body max-w-2xl">
          {settings.hero.subtitle}
        </p>
        <div class="mt-10 flex flex-col sm:flex-row gap-4">
          <Button href={withBase(settings.hero.ctaPrimary.href)} variant="primary">
            {settings.hero.ctaPrimary.label}
          </Button>
          <Button href={withBase(settings.hero.ctaSecondary.href)} variant="secondary">
            {settings.hero.ctaSecondary.label} →
          </Button>
        </div>
      </div>
    </section>

    <AboutSection
      title={settings.about.title}
      body={settings.about.body}
      points={settings.about.points}
      media={homepageMedia.about.xrTrainingOverview}
    />

    <TrainingChallengesSection
      eyebrow={settings.trainingChallenges.eyebrow}
      title={settings.trainingChallenges.title}
      intro={settings.trainingChallenges.intro}
      cards={settings.trainingChallenges.cards}
      media={homepageMedia.xrTraining.challengesBackground}
    />

    <WhyXrSection
      eyebrow={settings.whyXr.eyebrow}
      title={settings.whyXr.title}
      subtitle={settings.whyXr.subtitle}
      points={settings.whyXr.points}
      media={homepageMedia.xrTraining.multiUserTraining}
    />

    <SolutionsSection
      eyebrow={settings.sectionLabels.solutionsEyebrow}
      title={settings.sectionLabels.solutions}
      intro={settings.sectionLabels.solutionsIntro}
      allLinkLabel={settings.sectionLabels.solutionsAllLink}
      allLinkHref={`/${locale}/solutions/`}
      learnMoreLabel={settings.sectionLabels.learnMore}
      items={solutionEntries.map((e) => {
        // fire-rescue only has a page for zh-tw so far; en/jp fall back to
        // their own homepage rather than linking to a 404. The other three
        // solution pages now exist for all three locales.
        const hasPage = locale === "zh-tw" || e.data.itemSlug !== "fire-rescue";
        return {
          href: hasPage ? `/${locale}/solutions/${e.data.itemSlug}/` : `/${locale}/`,
          code: e.data.code,
          englishName: e.data.englishName,
          title: e.data.title,
          excerpt: e.data.excerpt,
          ctaLabel: e.data.ctaLabel,
          media: homepageMedia.solutions[solutionMediaKey[e.data.itemSlug]],
        };
      })}
    />

    <CoreCapabilitiesSection
      eyebrow={settings.coreCapabilities.eyebrow}
      title={settings.coreCapabilities.title}
      intro={settings.coreCapabilities.intro}
      items={settings.coreCapabilities.items}
      media={homepageMedia.capabilities.instructorSystem}
    />

    <ProofSection
      eyebrow={settings.proof.eyebrow}
      title={settings.proof.title}
      intro={settings.proof.intro}
      items={settings.proof.items}
      media={homepageMedia.proof.realWorldDeployment}
      partnersLabel={settings.sectionLabels.trustedBy}
      partners={settings.trustedBy[0]?.includes("pending") || settings.trustedBy[0]?.includes("準備中") ? [] : settings.trustedBy}
    />

    {
      showContentCards && settings.casesSection && caseEntries.length > 0 && (
        <ContentCardGrid
          bgClass="bg-white"
          title={settings.casesSection.title}
          subtitle={settings.casesSection.subtitle}
          ctaLabel={settings.casesSection.ctaLabel}
          ctaHref={settings.casesSection.ctaHref}
          items={caseEntries.slice(0, 4).map((e) => ({
            href: `/${locale}/cases/${e.data.itemSlug}/`,
            title: e.data.title,
            media: e.data.image,
          }))}
        />
      )
    }

    {
      showContentCards && settings.newsSection && newsEntries.length > 0 && (
        <ContentCardGrid
          bgClass="bg-light-soft"
          title={settings.newsSection.title}
          subtitle={settings.newsSection.subtitle}
          ctaLabel={settings.newsSection.ctaLabel}
          ctaHref={settings.newsSection.ctaHref}
          items={newsEntries.slice(0, 4).map((e) => ({
            href: `/${locale}/news/${e.data.itemSlug}/`,
            title: e.data.title,
            media: e.data.coverImage,
          }))}
        />
      )
    }

    <CTASection
      eyebrow={settings.missionCta.eyebrow}
      title={settings.missionCta.title}
      body={settings.missionCta.body}
      ctaPrimary={settings.missionCta.ctaPrimary}
      ctaSecondary={settings.missionCta.ctaSecondary}
      media={homepageMedia.cta.finalTraining}
    />
  </main>

  <Footer
    locale={locale}
    description={settings.footer.description}
    companyName={settings.footer.companyName}
    address={settings.footer.address}
    email={settings.footer.email}
    menu={settings.footer.menu}
    about={settings.footer.about}
    newsletterLabel={settings.footer.newsletterLabel}
    newsletterPlaceholder={settings.footer.newsletterPlaceholder}
    subscribeLabel={settings.footer.subscribeLabel}
    copyright={settings.footer.copyright}
  />
</Layout>
