---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import SEOHead from "@/components/SEOHead.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import DetailHero from "@/components/solutions/DetailHero.astro";
import PainPointsList from "@/components/solutions/PainPointsList.astro";
import CapabilityGrid from "@/components/solutions/CapabilityGrid.astro";
import ProductLinks from "@/components/solutions/ProductLinks.astro";
import OtherSolutionsNav from "@/components/solutions/OtherSolutionsNav.astro";
import CTASection from "@/components/CTASection.astro";
import { withBase } from "@/i18n/utils";
import { homepageMedia } from "@/data/homepage-media";
import { solutions } from "@/data/solutions";
import { solutionsMedia } from "@/data/solutions-media";

const settingsEntries = await getCollection("siteSettings");
const settings = settingsEntries.find((e) => e.data.locale === "zh-tw")!.data;
const data = solutions["fire-rescue"];
const media = solutionsMedia.fireRescue;
---

<Layout locale="zh-tw">
  <Fragment slot="head">
    <SEOHead
      locale="zh-tw"
      path="/solutions/fire-rescue/"
      title={data.seoTitle}
      description={data.seoDescription}
      availableLocales={["zh-tw"]}
    />
  </Fragment>

  <Header
    locale="zh-tw"
    currentPath="/zh-tw/solutions/fire-rescue/"
    nav={settings.nav.primary}
    cta={settings.nav.cta}
    availableLocales={["zh-tw"]}
  />

  <main class="flex-1">
    <DetailHero
      englishLabel={data.englishLabel}
      title={data.title}
      subtitle={data.heroSubtitle}
      heroDesktop={media.heroDesktop}
      heroMobile={media.heroMobile}
    />

    <div class="bg-navy-800">
      <div class="mx-auto max-w-[1440px] px-5 md:px-12 xl:px-20 py-4">
        <Breadcrumb
          items={[
            { label: "首頁", href: withBase("/zh-tw/") },
            { label: "解決方案", href: withBase("/zh-tw/solutions/") },
            { label: data.navTitle },
          ]}
        />
      </div>
    </div>

    <section class="bg-navy-800 pb-12 md:pb-16">
      <div class="mx-auto max-w-[1440px] px-5 md:px-12 xl:px-20">
        <div class="mb-6 inline-flex items-center gap-2 rounded border border-brand/[0.35] bg-brand/[0.12] px-3 py-2 text-caption text-brand">
          本頁為新版新增內容，非舊官網原始文案，文字尚待正式確認
        </div>
        <p class="text-base md:text-lg leading-[1.75] text-text-body max-w-2xl">{data.intro}</p>
      </div>
    </section>

    <section class="bg-bg py-12 md:py-16">
      <div class="mx-auto max-w-[1440px] px-5 md:px-12 xl:px-20">
        <PainPointsList eyebrow="TRAINING CHALLENGES" title="訓練需求" points={data.painPoints} />
      </div>
    </section>

    <section class="bg-navy-800 py-12 md:py-16">
      <div class="mx-auto max-w-[1440px] px-5 md:px-12 xl:px-20">
        <CapabilityGrid eyebrow="CAPABILITIES" title="可支援方向" items={data.applications} />
      </div>
    </section>

    <section class="bg-bg py-12 md:py-16">
      <div class="mx-auto max-w-[1440px] px-5 md:px-12 xl:px-20">
        <ProductLinks
          eyebrow="SYSTEMS"
          title="對應系統"
          products={data.products}
          emptyNote="目前尚無對應產品／套裝方案資料，待確認後補上連結。"
        />
      </div>
    </section>

    <section class="bg-navy-800 py-12 md:py-16">
      <div class="mx-auto max-w-[1440px] px-5 md:px-12 xl:px-20">
        <OtherSolutionsNav current="fire-rescue" />
      </div>
    </section>

    <CTASection
      eyebrow={settings.missionCta.eyebrow}
      title={settings.missionCta.title}
      ctaPrimary={settings.missionCta.ctaPrimary}
      ctaSecondary={settings.missionCta.ctaSecondary}
      media={homepageMedia.cta.contact}
    />
  </main>

  <Footer
    locale="zh-tw"
    companyName={settings.footer.companyName}
    address={settings.footer.address}
    email={settings.footer.email}
    menu={settings.footer.menu}
    about={settings.footer.about}
    newsletterLabel={settings.footer.newsletterLabel}
    newsletterPlaceholder={settings.footer.newsletterPlaceholder}
    subscribeLabel={settings.footer.subscribeLabel}
    copyright={settings.footer.copyright}
  />
</Layout>
