---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import SEOHead from "@/components/SEOHead.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import NarrativeBlock from "@/components/solutions/NarrativeBlock.astro";
import CTASection from "@/components/CTASection.astro";
import { withBase } from "@/i18n/utils";
import { homepageMedia } from "@/data/homepage-media";
import { solutionOrder, solutions, solutionsOverview } from "@/data/solutions";
import { solutionsMedia } from "@/data/solutions-media";

const settingsEntries = await getCollection("siteSettings");
const settings = settingsEntries.find((e) => e.data.locale === "zh-tw")!.data;

const coverMediaBySlug = {
  military: solutionsMedia.overview.militaryCover,
  police: solutionsMedia.overview.policeCover,
  "fire-rescue": solutionsMedia.overview.fireRescueCover,
  "smart-city": solutionsMedia.overview.smartCityCover,
} as const;

const orderedSolutions = solutionOrder.map((slug) => solutions[slug]);
---

<Layout locale="zh-tw">
  <Fragment slot="head">
    <SEOHead
      locale="zh-tw"
      path="/solutions/"
      title={solutionsOverview.seoTitle}
      description={solutionsOverview.seoDescription}
    />
  </Fragment>

  <Header
    locale="zh-tw"
    currentPath="/zh-tw/solutions/"
    nav={settings.nav.primary}
    cta={settings.nav.cta}
  />

  <main class="flex-1">
    <section class="bg-navy-800 pt-16 md:pt-20">
      <div class="mx-auto max-w-[1440px] px-5 md:px-12 xl:px-20 pt-10 pb-14 md:pt-14 md:pb-16">
        <Breadcrumb
          items={[{ label: "首頁", href: withBase("/zh-tw/") }, { label: "解決方案" }]}
          class="mb-6"
        />
        <p class="text-label font-mono font-bold uppercase tracking-[0.1em] text-brand mb-4">
          {solutionsOverview.eyebrow}
        </p>
        <h1 class="text-h1-page-sm md:text-h1-page-md xl:text-h1-page font-extrabold leading-[1.15] text-white max-w-2xl">
          {solutionsOverview.title}
        </h1>
        <p class="mt-6 text-base md:text-lg leading-[1.75] text-text-body max-w-2xl">
          {solutionsOverview.intro}
        </p>
      </div>
    </section>

    <section class="bg-bg py-10 md:py-14 xl:py-16">
      <div class="mx-auto max-w-[1440px] px-5 md:px-12 xl:px-20">
        {
          orderedSolutions.map((item, i) => (
            <NarrativeBlock
              code={item.code}
              englishLabel={item.englishLabel}
              navTitle={item.navTitle}
              excerpt={item.overviewExcerpt}
              representativeApplication={item.representativeApplication}
              href={`/zh-tw/solutions/${item.slug}/`}
              exploreLabel={solutionsOverview.exploreLabel}
              media={coverMediaBySlug[item.slug]}
              reverse={i % 2 === 1}
            />
          ))
        }
      </div>
    </section>

    <CTASection
      eyebrow={settings.missionCta.eyebrow}
      title={settings.missionCta.title}
      ctaPrimary={settings.missionCta.ctaPrimary}
      ctaSecondary={settings.missionCta.ctaSecondary}
      media={homepageMedia.cta.contact}
    />
  </main>

  <Footer
    locale="zh-tw"
    companyName={settings.footer.companyName}
    address={settings.footer.address}
    email={settings.footer.email}
    menu={settings.footer.menu}
    about={settings.footer.about}
    newsletterLabel={settings.footer.newsletterLabel}
    newsletterPlaceholder={settings.footer.newsletterPlaceholder}
    subscribeLabel={settings.footer.subscribeLabel}
    copyright={settings.footer.copyright}
  />
</Layout>
