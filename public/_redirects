# Netlify redirect rules for legacy URLs. Has no effect on GitHub Pages
# (ignored by the current deploy) — picked up automatically once the site
# moves to Netlify. Until then, the equivalent redirect is handled by the
# static HTML fallback pages under src/pages/{tw,zh-tw,en,jp,ja}/.

/tw/home       /zh-tw/   301
/tw            /zh-tw/   301
/tw/*          /zh-tw/   301
/zh-tw/home    /zh-tw/   301
/en/home       /en/      301
/jp/home       /ja/      301
/jp            /ja/      301
/jp/*          /ja/      301
/ja/home       /ja/      301
